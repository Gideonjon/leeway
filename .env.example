# --- NEAR Intents 1Click (https://partners.near-intents.org)
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Where the app fee lands: an ANY_INPUT deposit address from 1Click, or your .near account
LEEWAY_FEE_RECIPIENT=

# --- Economics (basis points). Cashback is paid out of the fee, so it must be <= the fee.
LEEWAY_APP_FEE_BPS=50
LEEWAY_CASHBACK_BPS=20
LEEWAY_CASHBACK_MIN_ZAT=100000            # 0.001 ZEC
LEEWAY_CASHBACK_DAILY_CAP_ZAT=1000000000  # 10 ZEC per rolling 24h

# --- Ghost Send
LEEWAY_GHOST_MIN_DELAY_SEC=600
LEEWAY_GHOST_MAX_DELAY_SEC=5400
LEEWAY_GHOST_MAX_USD=2000
LEEWAY_GHOST_PURGE_AFTER_SEC=86400
LEEWAY_ZEC_FEE_RESERVE_ZAT=30000
LEEWAY_SLIPPAGE_BPS=100

# --- Postgres
DATABASE_URL=postgresql://user:pass@host:5432/leeway

# --- Shielded wallet (Zallet or zcashd JSON-RPC)
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_ACCOUNT=0

# --- Shielded DCA on Base
BASE_RPC_URL=https://mainnet.base.org
LEEWAY_DCA_CONTRACT=
KEEPER_PRIVATE_KEY=
